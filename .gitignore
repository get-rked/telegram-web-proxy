.env
/docker/config/config.json
/docker/config/profiles.json
/docker/config/token.key
/docker/mtproxy/secret
/docker/mtproxy/certs/

/docker/profiles/profiles.json

/docker/config/config.json.backup-*
/docker/profiles/profiles.json.backup-*

# Preserve migration snapshots outside Git and Docker build context
docker/site.before-migration*/
docker/site.failed-migration*/

# Runtime-generated panel access secrets and private routes
/docker/private/panel-auth.json
/docker/private-credentials/panel-credentials.txt
/docker/generated/panel-route.caddy
/docker/generated/panel-route.nginx.conf

# Local Docker manager state (selected reverse proxy)
/docker/private/.manager-state

# Runtime files generated by the Docker deployment
/docker/security/logs/*.log
/docker/security/logs/*.log.*
/docker/site/about.html
/docker/site/contact.html
/docker/site/privacy.html
/docker/site/assets/
__pycache__/
docker/__pycache__/
docker/mtproxy/__pycache__/

# Local site content and certificates are runtime data; keep the tracked starter index.
/docker/site/*
!/docker/site/index.html
/docker/nginx/certs/
/docker/Caddyfile.before-*
/docker/config/*.before-*
