[tproxy-caddy-probes]
enabled = true
filter = tproxy-caddy-probes
logpath = /var/log/tproxy-panel/access.log
backend = auto
maxretry = 3
findtime = 10m
bantime = 1d
bantime.increment = true
bantime.factor = 2
bantime.maxtime = 1w
ignoreip = 127.0.0.1/8 ::1 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
usedns = no
action = docker-user[name=tproxy-probes]

[tproxy-nginx-probes]
enabled = true
filter = tproxy-nginx-probes
logpath = /var/log/tproxy-panel/access.log
backend = auto
maxretry = 3
findtime = 10m
bantime = 1d
bantime.increment = true
bantime.factor = 2
bantime.maxtime = 1w
usedns = no
action = docker-user[name=tproxy-nginx-probes]
