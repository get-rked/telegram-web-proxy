FROM golang:1.26.5-bookworm AS build
WORKDIR /src
COPY panel/go.mod ./
RUN go mod download
COPY panel/ ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/panel .
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/panel /panel
USER nonroot:nonroot
EXPOSE 8088
ENTRYPOINT ["/panel"]
