.git
.github
.env
*.log
backups
data

# Runtime secrets and operator-specific configuration
docker/config/config.json
docker/config/profiles.json
docker/config/token.key
docker/profiles/profiles.json*
docker/mtproxy/secret
docker/nginx/certs/

# Preserve migration snapshots outside Git and Docker build context
docker/site.before-migration*/
docker/site.failed-migration*/

# Native rollback tree may coexist in /opt/telegram-web-proxy.
# Keep binaries, source checkouts, configuration and systemd units out of Docker build context.
bin/
config/
src/
systemd/
qr/
